{"approver":"K. Naruse","candidate_content_hash":"25b4e3531e95158b49ccc32f806f131305b880988563b440ae2f75f1599672b7","candidate_id":"cand-5ae5865c1c222f8a","mapping_artifact":{"rows":[{"class":"corax:RobotMotion","entry":"protective-stop","note":"A protective stop is the safety system's commanded halt of the robot's motion; the entry records that it also indicates program or production problems, not only safety. CORA has no class for stop events or safety states, so the nearest concept is the process a protective stop interrupts, the robot's own motion (RobotMotion, 6.7). The relation is related, not narrower-than: a stop is not itself a motion.","relation":"related"}],"standard":"cora-ieee-1872"},"pack":"robotics","review":{"conflict_display":"not-applicable","conflicts":[],"quotation_bound_confirmed":false,"related_shown":[],"source_span":"not-applicable"},"schema":1,"source_reference":"staging:cand-5ae5865c1c222f8a","timestamp":"2026-09-20 22:30:21 JST","type":"approve"}
